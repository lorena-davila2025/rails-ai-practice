<div id="<%= dom_id product %>" class="card-product mb-5">
    <%= image_tag product.image_url, alt: product.name, class: "w-40 h-40 object-cover rounded" %>

    <div class="card-product-infos">
      <p>
        <strong>Name:</strong>
        <%= product.name %>
      </p>
      <p>
        <strong>Description:</strong>
        <%= product.description %>
      </p>
      <p>
        <%= link_to "Show this product", product %>
      </p>
    </div>
</div>
