<%# Flash notice %>
<% if notice %>
  <p style="color: green; background: #e6ffe6; padding: 10px; border: 1px solid #b3ffb3; border-radius: 4px;">
    <%= notice %>
  </p>
<% end %>

<%# Product Details Card %>
<div style="max-width: 80%; margin: 2rem auto; padding: 1rem; border: 1px solid #ccc; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); background: #fff;">
  <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;"><%= @product.name %></h1>

  <% if @product.image_url.present? %>
    <img src="<%= @product.image_url %>" alt="<%= @product.name %>" style="width: 100%; max-height: 300px; object-fit: cover; border-radius: 6px; margin-bottom: 1rem;">
  <% end %>

  <p class="" style="font-size: 1.2rem; color: #444;"><%= @product.description %></p>
  <p style="font-weight: bold; font-size: 1.4rem; color: #2f6f2f; margin-top: 0.5rem;">$<%= number_to_currency(@product.price, unit: "") %></p>
</div>

<%# Actions %>
<div class="d-flex justify-content-center gap-3">
  <%= link_to "Edit", edit_product_path(@product), class: "btn btn-success" %>
  <%= button_to "Delete", @product, class: "btn btn-danger", method: :delete, data: { confirm: "Are you sure?" }%>
</div>
  <%= link_to "← Back to products", products_path, class: "mt-3 text-center" %>
